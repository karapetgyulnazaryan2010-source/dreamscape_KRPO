# Copy to .env for local use. On Render, set these under Environment.
DATABASE_URL=postgresql://user:password@host:5432/dbname
SESSION_SECRET=put-a-long-random-string-here
# Website addresses allowed to call this server (comma separated)
FRONTEND_URL=https://dreamscape-web-five.vercel.app
# The account with this email becomes admin when it signs up (optional)
ADMIN_EMAIL=

# Optional: sends real "forgot password" emails (resend.com). Without it, the reset
# link is printed in the Render Logs so the owner can copy it.
RESEND_API_KEY=
EMAIL_FROM=Dreamscape <onboarding@resend.dev>

# AI Dream Guide, FREE option: Google Gemini. Get a key at aistudio.google.com -> Get API key.
# Keep it secret: only in Render, never in GitHub.
GEMINI_API_KEY=
# Optional: model name (default is the newest fast Gemini). If you get errors, use a name shown in AI Studio.
GEMINI_MODEL=gemini-flash-latest
# Optional daily cap on chat messages for the whole site
CHAT_DAILY_LIMIT=300
# Paid alternative (only used if GEMINI_API_KEY is empty): ANTHROPIC_API_KEY=
